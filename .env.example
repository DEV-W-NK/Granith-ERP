# Copie este arquivo para .env.local e preencha somente no ambiente local.
# Nunca versionar .env.local ou chaves reais.
# Este arquivo possui apenas configuracoes publicas do cliente Flutter.
# Segredos do Gemini, OAuth e service_role pertencem exclusivamente ao
# Supabase Secrets e nao devem ser adicionados aqui.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=SUA_CHAVE_PUBLICA_SUPABASE

GEMINI_MODEL=gemini-2.5-flash

GRANITH_ANIMATE_WEB_BACKDROP=false

GOOGLE_MAPS_API_KEY=SUA_CHAVE_GOOGLE_MAPS_SOMENTE_DEV

# OAuth Google fica configurado no Google Cloud e no Supabase Auth.
# Somente IDs publicos de cliente sao consumidos pelo Flutter.
GOOGLE_OAUTH_WEB_CLIENT_ID=SEU_CLIENT_ID_WEB
GOOGLE_OAUTH_ANDROID_CLIENT_ID=SEU_CLIENT_ID_ANDROID
GOOGLE_OAUTH_IOS_CLIENT_ID=SEU_CLIENT_ID_IOS
# Opcional: se vazio, scripts/run_dev.ps1 calcula a partir do Client ID iOS.
GOOGLE_OAUTH_IOS_REVERSED_CLIENT_ID=
